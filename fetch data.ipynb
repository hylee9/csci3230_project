   "source": [
    
//enter the api here
    "api_key = '\n",
    "api_secret = d'\n",
    "import pandas as pd\n",
    "import sqlalchemy\n",
    "import time\n",
    "from binance import ThreadedWebsocketManager\n",
    "import pprint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "b6f2c1e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "symbol = \"BTCUSDT\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "83a7d232",
   "metadata": {},
   "outputs": [],
   "source": [
    "twm = ThreadedWebsocketManager(api_key=api_key, api_secret=api_secret)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bfdcbc45",
   "metadata": {},
   "outputs": [],
   "source": [
    "twm.start()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "49ef6167",
   "metadata": {},
   "outputs": [],
   "source": [
    "engine = sqlalchemy.create_engine('sqlite:///BTCUSDTstreamrandom.db')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "7ea7a1d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def createframe(msg):\n",
    "    df = pd.DataFrame(msg['data'])\n",
    "    s = df['s'][0]\n",
    "    E = df['E'][0]\n",
    "    o = df['k']['c']    \n",
    "    data = {'symbol': s, 'Time': E, 'Price': o}\n",
    "    df = pd.DataFrame([data])\n",
    "    df.Price = df.Price.astype(float)\n",
    "    df.Time =  pd.to_datetime(df.Time, unit='ms')\n",
    "    df.to_sql('BTCUSDT', engine, if_exists='append', index=False)\n",
    "    print(df)\n",
    "    return df\n"
   ]
  },
